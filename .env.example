# Copy to `.env` before local release builds:
# cp .env.example .env
#
# Required for updater-signed build commands (`pnpm t:b:d` / `pnpm tauri build`).
# Generate a key pair once, for example:
# pnpm tauri signer generate -w ~/.tauri/qwesti.key
#
# Then use the private key contents and password here.
TAURI_SIGNING_PRIVATE_KEY="PASTE_TAURI_SIGNING_PRIVATE_KEY_CONTENT"
TAURI_SIGNING_PRIVATE_KEY_PASSWORD="PASTE_TAURI_SIGNING_PRIVATE_KEY_PASSWORD"
