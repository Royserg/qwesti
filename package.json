{
  "name": "qwesti",
  "version": "0.3.1",
  "description": "",
  "type": "module",
  "scripts": {
    "gen-icons:dev": "pnpm tauri icon -o ./icons/dev ./app-icon-dev.png",
    "gen-icons:prod": "pnpm tauri icon -o ./icons/prod ./app-icon.png",
    "prep-icons": "sh ./prepare-icons.sh",
    "d": "ENV=dev pnpm prep-icons && pnpm tauri dev",
    "d:android": "pnpm tauri android dev",
    "d:ios": "pnpm tauri ios dev",
    "start": "vite",
    "dev": "vite --force",
    "build": "ENV=prod pnpm prep-icons && vite build",
    "serve": "vite preview",
    "tauri": "tauri",
    "load-env": "env-cmd -f .env",
    "t:b:d": "ENV=prod pnpm tauri build",
    "t:b:android": "pnpm tauri android build --apk --target aarch64"
  },
  "dependencies": {
    "@corvu/drawer": "^0.2.4",
    "@dnd-kit/dom": "^0.3.2",
    "@dnd-kit/solid": "^0.3.2",
    "@kobalte/core": "^0.13.9",
    "@tailwindcss/vite": "^4.0.0",
    "@tanstack/solid-query": "^5.95.0",
    "@tanstack/solid-router": "^1.168.2",
    "@tauri-apps/api": "2.3.0",
    "@tauri-apps/plugin-opener": "2.2.6",
    "@tauri-apps/plugin-process": "^2.2.1",
    "@tauri-apps/plugin-updater": "2.7.1",
    "date-fns": "^4.1.0",
    "lucide-solid": "^0.501.0",
    "rehype-sanitize": "^6.0.0",
    "rehype-stringify": "^10.0.1",
    "remark-gfm": "^4.0.1",
    "remark-parse": "^11.0.0",
    "remark-rehype": "^11.1.2",
    "solid-js": "^1.9.11",
    "solid-transition-group": "^0.3.0",
    "tailwindcss": "^4.0.0",
    "ts-pattern": "^5.6.2",
    "unified": "^11.0.5",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@tanstack/router-plugin": "^1.167.3",
    "@tauri-apps/cli": "2.3.1",
    "@types/node": "^22.10.10",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "env-cmd": "^10.1.0",
    "prettier": "^3.4.2",
    "prettier-plugin-tailwindcss": "^0.6.11",
    "tailwind-merge": "3.0.2",
    "tailwindcss-animate": "^1.0.7",
    "typescript": "5.8.2",
    "vite": "^6.0.3",
    "vite-plugin-solid": "^2.11.11"
  }
}
