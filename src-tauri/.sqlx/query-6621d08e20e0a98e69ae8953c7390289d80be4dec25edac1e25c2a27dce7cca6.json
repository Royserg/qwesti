  "query": "\n        SELECT\n            id,\n            title,\n            completed,\n            created_at,\n            completed_at,\n            order_index,\n            parent_id\n        FROM\n            quests\n        WHERE\n            Date(completed_at) = DATE($1)\n            AND\n            parent_id IS NULL\n        ORDER BY\n            order_index, created_at DESC\n        ",
