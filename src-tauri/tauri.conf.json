{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Qwesti",
  "version": "0.1.7",
  "identifier": "com.qwesti.app",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Qwesti",
        "width": 800,
        "height": 600,
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "createUpdaterArtifacts": true,
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDZERjNCRTFGQUMxMTdCMjAKUldRZ2V4R3NINzd6YlprQ3F1eDQ1OVd1cms4VlpYQ1lxeTF4WisrYjl3OG56WWR4bGpXKyt6TVMK",
      "endpoints": [
        "https://gist.githubusercontent.com/Royserg/4f7b81dc3f463de01a528d337ef504f3/raw/qwesti.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
